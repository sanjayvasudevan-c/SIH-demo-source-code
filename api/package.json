  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "dev:scheduler": "tsx --env-file=../.env src/scheduler.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "start:scheduler": "node dist/src/scheduler.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "tsx --env-file=../.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=../.env prisma/seed.ts",
    "demo:reset": "tsx --env-file-if-exists=../.env scripts/demo-reset.ts",
    "demo:tamper": "tsx --env-file-if-exists=../.env scripts/demo-tamper.ts",
    "load:test": "tsx --env-file-if-exists=../.env scripts/load-test.ts",
    "setup:db": "tsx --env-file-if-exists=../.env scripts/setup.ts",
    "rules:schema": "tsx scripts/export-rulepack-schema.ts",
    "formcheck:defaults": "tsx scripts/export-formcheck-defaults.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@vercel/functions": "^2.2.13",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "prisma": "5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
