# Copy to .env for local development (npm run dev). Compose sets these itself.
POSTGRES_PASSWORD=postgres
MIGRATOR_PASSWORD=migrator_pw
APP_PASSWORD=app_pw
# API and scheduler connect as aicte_app
DATABASE_URL=postgresql://aicte_app:app_pw@localhost:5432/aicte
# Migrations and seed connect as aicte_migrator
MIGRATOR_URL=postgresql://aicte_migrator:migrator_pw@localhost:5432/aicte
# Superuser connection used only by demo reset / tamper / template build
DEMO_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
JWT_SECRET=change-me-to-a-long-random-string
DEMO_MODE=true
CLIENT_ORIGIN=http://localhost:5173
FORMCHECK_URL=http://localhost:8000
PORT=4000
